# Copy to the server as /var/www/pms-next/shared/.env.production
# Do not commit real secrets. REVALIDATE_SECRET must be unique per environment.

NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1

# Existing WordPress REST API on the production domain.
NEXT_PUBLIC_WORDPRESS_API_URL=https://peacemarineservices.com.au/wp-json/wp/v2

# Public GA4 measurement ID (not a secret).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DKZ9H681E2

# Optional. Required only if WordPress (or a webhook) should bust the blog cache.
# Send it as header x-revalidate-secret or query ?secret= to POST /api/revalidate-blog/
REVALIDATE_SECRET=
